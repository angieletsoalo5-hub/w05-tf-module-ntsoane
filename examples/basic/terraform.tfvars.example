aws_region    = "us-east-1"
aws_profile   = "sandbox"
project_name  = "w05-sandbox"
environment   = "lab"
instance_type = "t3.micro"
bucket_prefix = "w05-tf-module-your-name"
owner         = "your-name"
week          = "w05"
purpose       = "terraform-module-practice"
