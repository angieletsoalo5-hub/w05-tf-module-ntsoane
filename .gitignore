# Terraform working folders (providers/modules downloaded by `terraform init`)
.terraform/
**/.terraform/

# State files - may contain sensitive data, never commit them
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files with real values - keep only the *.example template
*.tfvars
*.tfvars.json
!*.tfvars.example

# Saved plans
tfplan
*.tfplan

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
